// Cloudflare Worker for Tack at parkerrupe.xyz/tack.
//   /tack/*      the static app (from dist/, built by build.sh)
//   /tack/api/*  the sync API (worker/index.js), with email/password accounts (Better Auth)
// Publish with: sh deploy.sh
{
  "name": "tack",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /tack redirects to /tack/, which serves /tack/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/tack/api/*"]
  },
  "routes": [
    { "pattern": "parkerrupe.xyz/tack", "zone_name": "parkerrupe.xyz" },
    { "pattern": "parkerrupe.xyz/tack/*", "zone_name": "parkerrupe.xyz" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "tack", "database_id": "48557965-07d4-4556-a93b-3691212edd7a" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "7bfe9cf2ad7e49368058afcd4edad80e" }
  ]
  // Better Auth needs BETTER_AUTH_SECRET: `npx wrangler secret put BETTER_AUTH_SECRET` (and in .dev.vars locally).
}
